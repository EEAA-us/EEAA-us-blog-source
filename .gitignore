# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production.example
**/node_modules/
**/.wrangler/
*.sqlite
*.sqlite3
*.sqlite3-*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# blog posts (content is managed separately)
/content/posts/

# Local publication workspaces and private AI revision history
/.publish/
/backend/.private/
/.firecrawl/

# Private local data, generated files and development records
/.tmp/
/.tmp*/
/backend/venv/
/backend/.venv/
/backend/uploads/
*.db
*.db-*
*.db.*
**/__pycache__/
*.py[cod]
/backend/admin/dist/
/runtime_state.json
/progress.md
/feature_list.json
/evidence/
/memory/

# Old compiled admin output kept locally, excluded from the source release.
/backend/admin/build/platform-config.json
/backend/admin/build/version.json
/backend/admin/build/favicon.ico
/backend/admin/build/logo.svg
