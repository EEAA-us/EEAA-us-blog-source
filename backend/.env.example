# 数据库
# 默认本地 SQLite；切换 PostgreSQL 时填写自己的连接串。
DATABASE_URL=sqlite:///./kirameku.db

# 应用密钥：必填，至少 32 字节，每个安装独立生成，不要提交到仓库。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 将生成结果填写在下方；已有有效密钥无需更换，改动会使旧登录令牌失效。
SECRET_KEY=

# CORS 允许的来源（逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8849,http://127.0.0.1:8849

# GitHub OAuth（可选）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 示例使用 local（backend/uploads）；可改为 oss 并填写下方 OSS 配置。
# local 图片在发布时按公开内容引用复制到线上；更改模式不会迁移已有图片。
BLOG_UPLOAD_STORAGE=local

# 阿里云 OSS：缺少必需配置时上传返回明确的 503 提示，不发起网络上传。
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=
OSS_CUSTOM_DOMAIN=
OSS_PREFIX=uploads/
